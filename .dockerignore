# Version control and repository metadata
.git/
.github/
.gitignore
.gitattributes

# Docker files are supplied separately from the build context
.dockerignore
**/Dockerfile*
docker-compose*.yml
docker-compose*.yaml
compose*.yml
compose*.yaml

# Installed dependencies
**/node_modules/

# Build output, generated files, and tool caches
**/dist/
**/.next/
**/out/
**/build/
**/coverage/
**/*.tsbuildinfo
**/.cache/
**/.turbo/
**/.eslintcache
database/prisma/generated/

# Local configuration and secrets
**/.env
**/.env.*
**/.npmrc

# Tests and test artifacts are not needed by the production builds
**/test/
**/tests/
**/__tests__/
**/*.spec.*
**/*.test.*

# Logs and temporary files
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/tmp/
**/temp/
**/*.tmp

# Editor and operating-system files
**/.idea/
**/.vscode/
**/.DS_Store
**/Thumbs.db
**/*~
**/*.swp

# Documentation and planning material
docs/
**/*.md
LICENSE
