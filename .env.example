# Copy this file to .env and adjust as needed. Docker Compose and the apps
# both read from .env at the repository root.

# --- Shared ---
NODE_ENV=development

# --- API (apps/api) ---
PORT=4000
DATABASE_URL=postgresql://money_movement:money_movement@localhost:5432/money_movement?schema=public
REDIS_URL=redis://localhost:6379
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Auth — replace with a random 32+ char secret for anything beyond local dev.
JWT_ACCESS_SECRET=dev-only-change-me-0123456789abcdef0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Wallet seed balance in integer minor units (poisha). 10,000,000 = BDT 100,000.
INITIAL_WALLET_BALANCE_MINOR=10000000

# --- Web (apps/web) ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# --- Postgres (container only — used by docker-compose.yml to init the DB) ---
POSTGRES_USER=money_movement
POSTGRES_PASSWORD=money_movement
POSTGRES_DB=money_movement
