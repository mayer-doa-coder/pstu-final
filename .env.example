# Copy this file to .env and adjust as needed. Docker Compose and the apps
# both read from .env at the repository root.

# --- Shared ---
NODE_ENV=development

# --- API (apps/api) ---
PORT=4000
DATABASE_URL=postgresql://money_movement:money_movement@localhost:5432/money_movement?schema=public
REDIS_URL=redis://localhost:6379
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Auth — replace with a random 32+ char secret for anything beyond local dev.
JWT_ACCESS_SECRET=dev-only-change-me-0123456789abcdef0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Wallet seed balance in integer minor units (poisha). 10,000,000 = BDT 100,000.
INITIAL_WALLET_BALANCE_MINOR=10000000

# Optional. Only the worker process uses this, to generate a one-sentence
# plain-language explanation for a HIGH-risk transfer. Leave blank to skip —
# the deterministic risk score/level/reasons work fully without it.
OPENAI_API_KEY=
# Optional override; defaults to gpt-4o-mini if left blank.
OPENAI_MODEL=

# Per-user rolling send limits, in integer minor units (poisha). A transfer
# must fit under all three independent windows. Defaults: BDT 1,000,000 /
# 3,000,000 / 10,000,000.
DAILY_TRANSFER_LIMIT_MINOR=100000000
WEEKLY_TRANSFER_LIMIT_MINOR=300000000
MONTHLY_TRANSFER_LIMIT_MINOR=1000000000

# --- Web (apps/web) ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# --- Postgres (container only — used by docker-compose.yml to init the DB) ---
POSTGRES_USER=money_movement
POSTGRES_PASSWORD=money_movement
POSTGRES_DB=money_movement
