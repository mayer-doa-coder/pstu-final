// Money Movement — Prisma schema.
//
// Milestone 1 (Auth + User + Wallet) and Milestone 3 (Direct transfer core:
// transfers, ledger_entries, idempotency_records, outbox_events) are defined
// here. Money requests, notifications, and audit arrive in later milestones
// per IMPLEMENTATION_GUIDE.md §4.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // `native` covers local dev; `debian-openssl-3.0.x` is the engine the
  // Docker images (node:22-slim) run, pinned explicitly so a mis-detected
  // build host can't fall back to an unloadable openssl-1.1.x engine.
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum TransferStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// Money-request lifecycle (IMPLEMENTATION_GUIDE.md §2.6). Only PENDING is a
// live state; ACCEPTED / DECLINED / CANCELLED / EXPIRED are terminal and
// never transition again. EXPIRED is reserved for a future sweeper — until
// then an elapsed `expiresAt` is derived at read time and blocks acceptance,
// but the stored value stays PENDING.
enum MoneyRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum TransferSourceType {
  DIRECT
  MONEY_REQUEST
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum IdempotencyState {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  // Native UUID column per IMPLEMENTATION_GUIDE.md §2.2. Generated as
  // UUIDv4 (Prisma's built-in default) rather than the guide's UUIDv7
  // preference — acceptable for this milestone since the column type is
  // unaffected; app-level UUIDv7 generation can be introduced later
  // without a schema change if the sequential-index benefit is needed.
  id           String     @id @default(uuid()) @db.Uuid
  // CITEXT gives case-insensitive uniqueness at the database level — the
  // real enforcement point for "normalized unique email" (PRD.md §3.1),
  // not just application-side lowercasing.
  email        String     @unique @db.Citext
  displayName  String     @map("display_name")
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  wallet             Wallet?
  authSessions       AuthSession[]
  transfersSent      Transfer[]          @relation("TransferSender")
  transfersReceived  Transfer[]          @relation("TransferReceiver")
  idempotencyRecords IdempotencyRecord[]
  moneyRequestsMade  MoneyRequest[]      @relation("MoneyRequestRequester")
  moneyRequestsOwed  MoneyRequest[]      @relation("MoneyRequestPayer")
  notifications      Notification[]
  auditEvents        AuditEvent[]

  // Serves GET /users/search (Milestone 2): the query always filters
  // status = 'ACTIVE' and sorts by (displayName, id) for cursor pagination,
  // so a composite index covers both the filter and the seek in one scan.
  // The unique index already on `email` covers the exact-match email path,
  // so no separate email index is added here.
  @@index([status, displayName, id])
  @@map("users")
}

model Wallet {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @unique @map("user_id") @db.Uuid
  currency     String       @default("BDT") @db.Char(3)
  // Integer minor units (poisha) only — see PRD.md §3.2. Never floating point.
  balanceMinor BigInt       @map("balance_minor")
  status       WalletStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id])
  transfersOut  Transfer[]    @relation("TransferSenderWallet")
  transfersIn   Transfer[]    @relation("TransferReceiverWallet")
  ledgerEntries LedgerEntry[]

  @@map("wallets")
}

// A single money movement between two wallets. The `transfers` module is the
// only code path allowed to create these and mutate wallet balances
// (IMPLEMENTATION_GUIDE.md §1.3). `status` is a strict state machine:
// PENDING is written first, then flipped to exactly one terminal value
// (SUCCEEDED / FAILED) inside the same DB transaction — terminal states
// never transition again.
model Transfer {
  id               String             @id @default(uuid()) @db.Uuid
  senderUserId     String             @map("sender_user_id") @db.Uuid
  receiverUserId   String             @map("receiver_user_id") @db.Uuid
  senderWalletId   String             @map("sender_wallet_id") @db.Uuid
  receiverWalletId String             @map("receiver_wallet_id") @db.Uuid
  // Integer minor units (poisha) only — never floating point. CHECK (> 0)
  // is enforced at the database level (see migration).
  amountMinor      BigInt             @map("amount_minor")
  currency         String             @default("BDT") @db.Char(3)
  status           TransferStatus     @default(PENDING)
  note             String?            @db.VarChar(280)
  // DIRECT for a peer-to-peer send; MONEY_REQUEST when created by
  // MoneyRequestService.accept(), with sourceRequestId pointing at the
  // originating request (invariant 9.4).
  sourceType       TransferSourceType @default(DIRECT) @map("source_type")
  sourceRequestId  String?            @map("source_request_id") @db.Uuid
  failureCode      String?            @map("failure_code") @db.VarChar(64)
  createdAt        DateTime           @default(now()) @map("created_at")
  completedAt      DateTime?          @map("completed_at")

  sender         User          @relation("TransferSender", fields: [senderUserId], references: [id])
  receiver       User          @relation("TransferReceiver", fields: [receiverUserId], references: [id])
  senderWallet   Wallet        @relation("TransferSenderWallet", fields: [senderWalletId], references: [id])
  receiverWallet Wallet        @relation("TransferReceiverWallet", fields: [receiverWalletId], references: [id])
  ledgerEntries  LedgerEntry[]
  sourceRequest  MoneyRequest? @relation("MoneyRequestSourceTransfer", fields: [sourceRequestId], references: [id])
  acceptedByRequest MoneyRequest? @relation("MoneyRequestAcceptedTransfer")

  @@index([senderUserId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_transfers_sender_created")
  @@index([receiverUserId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_transfers_receiver_created")
  @@index([sourceRequestId], map: "idx_transfers_request")
  @@map("transfers")
}

// Append-only double-entry ledger. Every successful transfer writes exactly
// one DEBIT and one CREDIT row whose `signedAmountMinor` values sum to zero
// (IMPLEMENTATION_GUIDE.md §2.5 / §9.1). Rows are NEVER updated or deleted —
// a correction is a new compensating transfer, not an edit.
model LedgerEntry {
  id                String          @id @default(uuid()) @db.Uuid
  transferId        String          @map("transfer_id") @db.Uuid
  walletId          String          @map("wallet_id") @db.Uuid
  direction         LedgerDirection
  amountMinor       BigInt          @map("amount_minor")
  // = -amountMinor for DEBIT, +amountMinor for CREDIT. A DB CHECK keeps the
  // sign consistent with `direction` (see migration).
  signedAmountMinor BigInt          @map("signed_amount_minor")
  currency          String          @db.Char(3)
  // Wallet balance immediately after this entry was applied — a running
  // balance snapshot for audit/reconciliation, captured under the row lock.
  balanceAfterMinor BigInt          @map("balance_after_minor")
  createdAt         DateTime        @default(now()) @map("created_at")

  transfer Transfer @relation(fields: [transferId], references: [id])
  wallet   Wallet   @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_ledger_wallet_created")
  @@index([transferId], map: "idx_ledger_transfer")
  @@map("ledger_entries")
}

// A request for money from `payer` to `requester` (IMPLEMENTATION_GUIDE.md
// §2.6 / §3.9–§3.14). Creating one moves NO money and touches NO wallet —
// only `accept` does, and it delegates every debit/credit to the transfer
// domain (never reimplemented here). The row is locked `FOR UPDATE` before
// any state transition so concurrent accept/decline/cancel calls serialize
// and exactly one terminal outcome commits.
model MoneyRequest {
  id                 String             @id @default(uuid()) @db.Uuid
  requesterUserId    String             @map("requester_user_id") @db.Uuid
  payerUserId        String             @map("payer_user_id") @db.Uuid
  // Integer minor units (poisha). CHECK (> 0) enforced in the migration.
  amountMinor        BigInt             @map("amount_minor")
  currency           String             @default("BDT") @db.Char(3)
  note               String?            @db.VarChar(280)
  status             MoneyRequestStatus @default(PENDING)
  // Set exactly when status becomes ACCEPTED — the transfer that settled this
  // request (invariant 9.3). UNIQUE: one request per settling transfer.
  acceptedTransferId String?            @unique @map("accepted_transfer_id") @db.Uuid
  expiresAt          DateTime?          @map("expires_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  resolvedAt         DateTime?          @map("resolved_at")

  requester        User      @relation("MoneyRequestRequester", fields: [requesterUserId], references: [id])
  payer            User      @relation("MoneyRequestPayer", fields: [payerUserId], references: [id])
  acceptedTransfer Transfer? @relation("MoneyRequestAcceptedTransfer", fields: [acceptedTransferId], references: [id])
  sourceTransfers  Transfer[] @relation("MoneyRequestSourceTransfer")

  // (userId, created_at DESC, id DESC) serves both the incoming/outgoing
  // request lists and the activity feed's keyset pagination in one scan; the
  // optional status filter is applied as a residual predicate.
  @@index([payerUserId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_money_requests_payer_created")
  @@index([requesterUserId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_money_requests_requester_created")
  @@map("money_requests")
}

// Durable retry-safety record (IMPLEMENTATION_GUIDE.md §1.6). One row per
// (actorUserId, routeKey, idempotencyKey); a completed row stores the exact
// canonical response so a retried request replays it byte-for-byte instead
// of moving money twice. Never Redis-only — financial correctness needs this
// in PostgreSQL.
model IdempotencyRecord {
  id             String           @id @default(uuid()) @db.Uuid
  actorUserId    String           @map("actor_user_id") @db.Uuid
  routeKey       String           @map("route_key") @db.VarChar(80)
  idempotencyKey String           @map("idempotency_key") @db.VarChar(128)
  // SHA-256 of the canonical request payload. Same key + different hash =>
  // 409 IDEMPOTENCY_KEY_REUSED.
  requestHash    String           @map("request_hash") @db.Char(64)
  state          IdempotencyState
  responseStatus Int?             @map("response_status")
  responseBody   Json?            @map("response_body")
  resourceType   String?          @map("resource_type") @db.VarChar(32)
  resourceId     String?          @map("resource_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  expiresAt      DateTime         @map("expires_at")

  actor User @relation(fields: [actorUserId], references: [id])

  @@unique([actorUserId, routeKey, idempotencyKey], map: "idempotency_records_actor_route_key_key")
  @@map("idempotency_records")
}

// Transactional outbox (IMPLEMENTATION_GUIDE.md §2.8 / §6). The domain event
// is inserted in the SAME transaction as the financial write, so it commits
// atomically with the money movement. The worker process drains unprocessed
// rows asynchronously; if it is down, rows simply accumulate as `processedAt
// IS NULL`, which never blocks or fails a transfer.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(32)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(80)
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at")
  processedAt   DateTime? @map("processed_at")
  attemptCount  Int       @default(0) @map("attempt_count")
  lastError     String?   @map("last_error")
  // Exponential-backoff gate: a failed event is not re-claimable until this
  // moment passes, so one poisonous row can't spin the worker hot.
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")

  @@index([occurredAt], map: "idx_outbox_unprocessed")
  @@map("outbox_events")
}

// In-app notification produced by the outbox worker (never by the financial
// transaction itself). Delivery is at-least-once, so `sourceEventId` +
// `userId` is UNIQUE: re-processing the same outbox event is a no-op insert
// rather than a duplicate notification.
model Notification {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  type          String    @db.VarChar(64)
  title         String    @db.VarChar(160)
  body          String    @db.VarChar(500)
  resourceType  String?   @map("resource_type") @db.VarChar(32)
  resourceId    String?   @map("resource_id") @db.Uuid
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  /// The outbox event this notification was derived from — the dedupe key.
  sourceEventId String    @map("source_event_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@unique([sourceEventId, userId], map: "notifications_source_event_user_key")
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_notifications_user_created")
  @@map("notifications")
}

// Append-only audit trail for critical actions (IMPLEMENTATION_GUIDE.md
// §2.10). `metadata` carries only identifiers and safe scalars — never
// passwords, tokens, CSRF secrets, or free-text note content.
model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  /// Null for actions with no authenticated actor (e.g. a failed login).
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.VarChar(80)
  resourceType String   @map("resource_type") @db.VarChar(32)
  resourceId   String?  @map("resource_id") @db.Uuid
  // The correlation ID from RequestIdMiddleware. VARCHAR, not UUID: a caller
  // may supply its own `X-Request-Id`, and an audit row must never be lost to
  // a cast failure.
  requestId    String?  @map("request_id") @db.VarChar(128)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt(sort: Desc)], map: "idx_audit_actor_created")
  @@index([resourceType, resourceId], map: "idx_audit_resource")
  @@index([requestId], map: "idx_audit_request")
  @@map("audit_events")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  // Only the hash is ever persisted — the raw refresh token exists solely
  // in the HttpOnly cookie on the client. A unique index lets /auth/refresh
  // resolve "which session" directly from the presented token alone.
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("auth_sessions")
}
